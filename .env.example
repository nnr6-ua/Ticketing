# Copia este archivo a .env y ajusta los valores para tu entorno.
# Nunca subas .env al repositorio: contiene secretos locales.

# Puertos publicados en el host.
FRONTEND_PORT=8080
BACKEND_PORT=8000

# PostgreSQL. Cambia la contraseña en cualquier entorno compartido.
# Solo se aplica al inicializar el volumen; si cambias la contraseña después,
# actualiza el rol en la base o recrea el volumen con `docker compose down -v`.
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=cambia-esta-clave

# Backend.
APP_ENV=production
# Cadena usada por FastAPI, SQLAlchemy y Alembic dentro de Docker Compose.
# Solo es necesario definirla si quieres apuntar a una base externa; si se
# omite, docker-compose.yml la construye con los valores POSTGRES_* de arriba.
# DATABASE_URL=postgresql+psycopg://usuario:clave@db:5432/ticketing

# Secreto y validación del token JWT emitido por el proveedor de autenticación.
# Sin JWT_SECRET, la API rechaza todas las peticiones protegidas con 401.
# Con el stub de desarrollo habilitado, Compose genera un secreto efímero al
# arrancar si esta variable está vacía.
JWT_SECRET=
JWT_ALGORITHM=HS256
AUTH_ISSUER=
AUTH_AUDIENCE=

# Stub de autenticación SOLO para desarrollo local. Permite obtener un JWT de
# los usuarios del seed desde /login sin proveedor externo. Ponlo a false en
# cualquier entorno compartido o de producción.
AUTH_DEV_STUB_ENABLED=true

# Orígenes permitidos por CORS (separados por coma).
FRONTEND_ORIGINS=http://localhost:8080

# Reintentos de las migraciones al arrancar el backend.
MIGRATION_MAX_ATTEMPTS=30
MIGRATION_RETRY_SECONDS=2

# URL del API compilada en el frontend. Vacío = mismo origen a través de Nginx.
# Si cambias este valor, reconstruye la imagen del frontend.
VITE_API_BASE_URL=
