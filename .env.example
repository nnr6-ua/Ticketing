# Copia este archivo a `.env` y ajusta los valores.
# Windows PowerShell: Copy-Item .env.example .env
# `.env` está ignorado por Git.

# Puertos publicados en el host.
FRONTEND_PORT=8080
BACKEND_PORT=8000

# PostgreSQL del servicio `db`. Si cambias usuario, contraseña o base,
# actualiza también DATABASE_URL para que apunte a los mismos valores.
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing

# Conexión usada por el backend y por Alembic. Si se omite, Compose usa
# postgresql+psycopg://ticketing:ticketing@db:5432/ticketing.
# Codifica los caracteres reservados de la contraseña si contiene @, :, /, etc.
# DATABASE_URL=postgresql+psycopg://ticketing:ticketing@db:5432/ticketing

# Directorio donde el backend guarda los adjuntos de los tickets.
ATTACHMENTS_DIR=./attachments

# Entorno de la aplicación.
APP_ENV=development

# Firma y validación de JWT. `dev-only-secret` solo vale para desarrollo local.
JWT_SECRET=dev-only-secret
JWT_ALGORITHM=HS256
# AUTH_ISSUER=
# AUTH_AUDIENCE=

# Stub de login de desarrollo (POST /api/v1/dev/login). Nunca en producción.
AUTH_DEV_STUB_ENABLED=true

# Orígenes permitidos para CORS en desarrollo (separados por coma).
FRONTEND_ORIGINS=http://localhost:8080

# Reintentos de `alembic upgrade head` al arrancar el backend.
MIGRATION_MAX_ATTEMPTS=30
MIGRATION_RETRY_SECONDS=2

# URL base del API compilada en la SPA. Vacío = mismo origen vía Nginx.
VITE_API_BASE_URL=
